# === Telegram bot ===
BOT_TOKEN=123456789:AAAA-your-telegram-bot-token-here

# Chat where reminders are sent (group/channel/user ID, e.g. -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890

# Telegram user ID of the admin who receives error alerts (optional)
ADMIN_TELEGRAM_ID=

# === Backend API ===
BACKEND_URL=http://backend:8000

# Service/admin bearer token for authorizing requests to the backend.
ADMIN_API_TOKEN=change-me

# Alternative: HTTP Basic Auth credentials, used instead of ADMIN_API_TOKEN
# if the backend requires admin login/password.
ADMIN_BASIC_AUTH_LOGIN=
ADMIN_BASIC_AUTH_PASSWORD=

# === Scheduler ===
# Timezone for the daily cron job (IANA tz name).
TIMEZONE=Europe/Moscow

# Hour/minute (local to TIMEZONE) at which the daily check runs.
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0

# How many days ahead of the due date to start reminding.
REMINDER_DAYS_AHEAD=3

# === Misc ===
# HTTP request timeout (seconds) for backend calls.
HTTP_TIMEOUT=15

# Path to the local SQLite file used to de-duplicate notifications.
# Defaults to notifications.db inside the /bot directory if unset.
SQLITE_PATH=
