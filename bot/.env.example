SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0
REMINDER_DAYS_AHEAD=3

# Runtime
HTTP_TIMEOUT=15
# Defaults to /bot/sent_log.db when empty
SQLITE_PATH=
