# Invoice Keeper bot configuration

BOT_TOKEN=8970015247:AAEss8e5OQ2gnlCXHkGRyhBQIp0icyDdsCg
# Дубликат для совместимости с конфигурацией бэкенда (TELEGRAM_CHAT_ID используется обоими)
TELEGRAM_CHAT_ID=-1004386842069

# VK Bots Long Poll (optional; set all values to enable VK)
# Create a group token with messages permission.
