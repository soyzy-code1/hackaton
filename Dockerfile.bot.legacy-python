# =============================================================================
#  Invoice Keeper — BOT (aiogram / telebot)
#  Отдельный образ: у бота свой набор зависимостей, но та же база python:3.11
# =============================================================================
# syntax=docker/dockerfile:1

# -----------------------------------------------------------------------------
# STAGE 1: builder
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libpq-dev \
        pkgconfig \
 && rm -rf /var/lib/apt/lists/*

COPY . /src

# Гарантируем существование каталога — COPY --from=builder не должен падать
RUN mkdir -p /src/bot /src/backend

# Детерминированный поиск манифеста зависимостей бота
RUN set -eux; \
    REQ=""; \
    for cand in /src/bot/requirements.txt \
                /src/bot/app/requirements.txt \
                /src/bot/bot/requirements.txt; do \
        if [ -f "$cand" ]; then REQ="$cand"; break; fi; \
    done; \
    if [ -z "$REQ" ]; then \
        REQ="$(find /src/bot -maxdepth 3 -type f -name 'requirements*.txt' \
                -not -path '*/node_modules/*' 2>/dev/null | sort | head -n 1)"; \
    fi; \
    if [ -n "$REQ" ]; then \
        echo ">>> Установка зависимостей бота из $REQ"; \
        pip install --prefix=/install -r "$REQ"; \
    elif [ -f /src/bot/pyproject.toml ]; then \
        echo ">>> Установка пакета bot из pyproject.toml"; \
        pip install --prefix=/install /src/bot; \
    else \
        echo ">>> ВНИМАНИЕ: requirements.txt бота не найден — зависимости не установлены"; \
    fi

# -----------------------------------------------------------------------------
# STAGE 2: runtime
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH="/usr/local/bin:${PATH}" \
    TZ=Europe/Moscow

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        curl \
        libpq5 \
        tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime \
 && echo "${TZ}" > /etc/timezone

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /src/bot /app/bot
COPY --from=builder /src/scripts /scripts

RUN chmod +x /scripts/*.sh 2>/dev/null || true \
 && mkdir -p /tmp

# Healthcheck: бот держит heartbeat-файл /tmp/bot_alive (его обновляет entrypoint)
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
    CMD test -f /tmp/bot_alive && now=$(date +%s) && mtime=$(stat -c %Y /tmp/bot_alive 2>/dev/null || echo 0) && [ $(( now - mtime )) -lt 120 ]

CMD ["/scripts/entrypoint-bot.sh"]
