APP_ENV=dev
DATABASE_URL=sqlite:///./invoice_keeper.db
SECRET_KEY=change-me-in-production
SESSION_TTL_HOURS=24
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
TIMEZONE=Europe/Moscow
REMINDER_DAYS_BEFORE=3
TELEGRAM_CHAT_ID=
INTERNAL_API_TOKEN=change-me-internal-token

# GigaChat. Credentials are provided by the GigaChat API account as a Base64
# string for client_id:client_secret. Never expose this value to the frontend.
GIGACHAT_ENABLED=true
GIGACHAT_CREDENTIALS=01a16f81-20dc-77e1-b09d-f86aeafcd143:e99aa519-fcc9-4502-ae2c-9d5ba7d7a75b
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_TLS=true

# Email-напоминания (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=antbkkahack@mail.ru
SMTP_PASSWORD=KRRcbgrFld2uKY10SXj9
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# Webhook (события + напоминания о сроке)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://example.com/hooks/invoice-keeper
