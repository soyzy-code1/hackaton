# =============================================================================
#  Invoice Keeper — пример файла окружения
# -----------------------------------------------------------------------------
#  ВНИМАНИЕ: здесь только шаблоны. Реальных секретов нет.
#  Скопируйте файл в .env и подставьте свои значения:
#
#      cp .env.example .env        (Linux/macOS/Git Bash)
#      copy .env.example .env      (Windows CMD)
#      Copy-Item .env.example .env (Windows PowerShell)
#
#  Файл .env НЕ должен попадать в git (он уже в .gitignore).
#  Все переменные отсюда попадают в контейнеры backend и bot (env_file: .env).
# =============================================================================

# -----------------------------------------------------------------------------
# --- Database (PostgreSQL) ---
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_keeper

# -----------------------------------------------------------------------------
# Строка подключения к БД для Go-бэкенда.
#
# ВАЖНО (см. README, раздел "Блокеры"): текущий Go-код бэкенда совместим только
# с SQLite — DDL миграций использует AUTOINCREMENT, запросы используют плейсхолдер
# "?", а код полагается на Result.LastInsertId(), который pgx не поддерживает.
# Штатный режим запуска — SQLite-файл в постоянном volume'е:
DATABASE_URL=sqlite:///./data/invoice_keeper.db
#
# PostgreSQL-строка оставлена для будущей адаптации бэкенда (требует правки Go-кода):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/invoice_keeper

# -----------------------------------------------------------------------------
# --- Redis ---
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# --- Backend / Auth ---
# -----------------------------------------------------------------------------
# Логин и пароль единственного администратора. Создаётся при первом старте backend
# и НЕ меняется из панели — это критерий приёмки кейса.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Секрет подписи JWT (SECRET_KEY в терминах Go-бэкенда).
# Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
JWT_SECRET=change_me_in_production

# Время жизни сессии в часах
SESSION_TTL_HOURS=24

# Токен для internal-API бэкенда (X-Internal-Token).
# Его же использует бот для запросов к /api/v1/internal/...
INTERNAL_API_TOKEN=change_me_internal_token
# Тот же токен под именем, которое ожидает бот
ADMIN_API_TOKEN=change_me_internal_token

# -----------------------------------------------------------------------------
# --- Backend / Reminders (фоновый воркер внутри процесса backend) ---
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Moscow
# За сколько дней до срока платежа формируется напоминание
REMINDER_DAYS_BEFORE=3
# Как часто воркер опрашивает БД (секунды)
NOTIFY_POLL_SECONDS=60
APP_ENV=dev

# -----------------------------------------------------------------------------
# --- Telegram Bot ---
# -----------------------------------------------------------------------------
# Токен от @BotFather (/newbot). Имя переменной BOT_TOKEN — так ожидает бот.
BOT_TOKEN=
# Дубликат для совместимости с конфигурацией бэкенда (TELEGRAM_CHAT_ID используется обоими)
TELEGRAM_BOT_TOKEN=
# REQUIRED for demo: real chat_id from Telegram (e.g. -1001234567890 for a group,
# 123456789 for a user). Get it via @userinfobot or by adding the bot to a group.
# Without a real chat_id, reminders will fail with "chat not found" in bot logs.
# Значение -1001234567890 ниже — только шаблон, замените его в .env.
TELEGRAM_CHAT_ID=-1001234567890
# Telegram-ID администратора для алертов об ошибках (необязательно)
ADMIN_TELEGRAM_ID=

# Адрес Go-бэкенда изнутри docker-сети
BACKEND_URL=http://backend:8000

# Расписание ежедневной проверки (локальное время TIMEZONE)
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0
# Дубликат REMINDER_DAYS_BEFORE под именем, которое ожидает бот
REMINDER_DAYS_AHEAD=3
HTTP_TIMEOUT=15

# -----------------------------------------------------------------------------
# --- Telegram proxy (optional, tgwsapiproxy + Cloudflare Worker) ---
# -----------------------------------------------------------------------------
# Leave TELEGRAM_PROXY empty for a direct connection.
TELEGRAM_PROXY=
# Set the Cloudflare Worker host when TELEGRAM_PROXY is enabled.
TELEGRAM_PROXY_WORKER_HOST=

# -----------------------------------------------------------------------------
# --- Frontend (github.com/Vatalone/aeza, Vite) ---
# Переменные VITE_* вшиваются в публичный JS-бандл на этапе build — секреты сюда НЕ класть.
# После изменения: docker compose up -d --build frontend
# -----------------------------------------------------------------------------
# Базовый URL API для браузера: nginx проксирует /api/ на backend (CORS не нужен).
VITE_API_URL=/api/v1
# true — принудительно включить встроенный mock-бэкенд фронтенда (демо без backend)
VITE_USE_MOCK=false
# Путь к исходникам фронтенда относительно корня проекта
FRONTEND_DIR=frontend

# -----------------------------------------------------------------------------
# --- SMTP (необязательно; email-напоминания) ---
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# -----------------------------------------------------------------------------
# --- Webhook (необязательно; события и напоминания) ---
# -----------------------------------------------------------------------------
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# --- Порты на хосте (менять при конфликте) ---
# -----------------------------------------------------------------------------
HTTP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
