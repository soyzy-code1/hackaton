# Base URL of the backend API. Default: /api/v1 (proxied to the backend in dev).
VITE_API_URL=/api/v1

# Backend address used by the Vite dev-server proxy.
VITE_PROXY_TARGET=http://localhost:8000

# Force the built-in mock backend ("true"/"false").
# When "false", the client still falls back to mocks if the network is unreachable.
VITE_USE_MOCK=false

# Credentials of the admin account created by the backend from its own .env.
# The frontend uses them only to hide the admin from the users table.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin
