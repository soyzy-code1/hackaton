# Frontend API settings
# Base URL of the backend API. Default: /api/v1 (proxied to backend in dev).
VITE_API_URL=/api/v1

# Public link to the team Telegram conversation.
# This value is safe to expose in frontend code; never put tokens here.
VITE_TELEGRAM_BOT_URL=https://t.me/+iaxnNcL3atIxZmUy

# Backend address used by the Vite dev-server proxy.
VITE_PROXY_TARGET=http://localhost:8000

# Force the built-in mock backend ("true"/"false").
# When "false", the client still falls back to mocks if the network is unreachable.
VITE_USE_MOCK=false

# The admin account is configured in backend/.env. The frontend does not need
# the admin password and must not store it in a public Vite variable.
VITE_ADMIN_USERNAME=admin
